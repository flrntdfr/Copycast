# Copy to .env next to docker-compose.yml and adjust. Every value here is read by
# docker compose for interpolation; the application itself is configured through
# config/copycast.toml and COPYCAST__* variables (see docs/operations.md).
#
# Before the first start create the bind-mounted directories and hand the data
# directory to the container user (uid 1000 unless you change COPYCAST_UID/GID):
#
#   mkdir -p data config && chown -R 1000:1000 data

# Which services to start: "tailscale" (recommended, app reachable only inside your tailnet)
# or "direct" (publishes port 8080 on this host; only for a trusted network).
COMPOSE_PROFILES=tailscale

# Tailscale auth key for the sidecar (profile tailscale). Create one at
# https://login.tailscale.com/admin/settings/keys; a reusable, tagged key is recommended.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Password of the bundled Postgres. Change it once, before the first start; changing it later
# requires updating the database as well.
POSTGRES_PASSWORD=change-me

# Public address your podcast app reaches Copycast at. It is embedded in every feed and media
# URL, so it must be the address the *clients* see:
#   tailscale profile: https://copycast.<your-tailnet>.ts.net
#   direct profile:    http://<host-or-ip>:8080
COPYCAST_BASE_URL=https://copycast.example-tailnet.ts.net

# Optional: switch authentication on (docs/adr/0011). With a password (8+ characters) set, the
# web UI and the API ask for it (HTTP Basic, username "copycast" unless COPYCAST_AUTH_USERNAME says otherwise),
# every feed takes its own username/password shown next to its URL in the UI, and MCP clients
# need an API key minted on the "API keys" page. Needs TLS in front (a reverse proxy) with the
# direct profile; unset means no authentication at all, as before.
#COPYCAST_AUTH_PASSWORD=
#COPYCAST_AUTH_USERNAME=copycast

# Optional: the image to run (defaults to the latest release) and the port published by the
# direct profile.
#COPYCAST_IMAGE=ghcr.io/flrntdfr/copycast:1.1.2
#COPYCAST_PORT=8080

# Optional: uid/gid the app runs as inside the containers. Match them to the owner of ./data.
#COPYCAST_UID=1000
#COPYCAST_GID=1000
